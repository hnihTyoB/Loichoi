generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  email                String?              @unique
  password             String?
  fullName             String?              @map("full_name")
  username             String?              @unique @map("username")
  bio                  String?
  bannerUrl            String?              @map("banner_url")
  isCreator            Boolean              @default(false) @map("is_creator")
  creatorStatus        String?              @default("NONE") @map("creator_status")
  creatorAppliedAt     DateTime?            @map("creator_applied_at")
  creatorRejectReason  String?              @map("creator_reject_reason")
  isFeaturedCreator    Boolean              @default(false) @map("is_featured_creator")
  socialLinks          Json?                @map("social_links")
  isActive             Boolean              @default(false) @map("is_active")
  roleId               String               @map("role_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  avatarUrl            String?              @map("avatar_url")
  deletedAt            DateTime?            @map("deleted_at")
  deletedBy            String?              @map("deleted_by") @db.Uuid
  phoneNumber          String?              @unique @map("phone_number")
  downloadQuotaResetAt DateTime?            @map("download_quota_reset_at")
  apiKeys              ApiKey[]
  downloads            Download[]
  emailNotifications   EmailNotification[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]
  refreshTokens        RefreshToken[]
  devices              UserDevice[]
  socialAccounts       UserSocial[]
  role                 Role                 @relation(fields: [roleId], references: [id])
  verificationTokens   VerificationToken[]
  webhookDeliveries    WebhookDelivery[]
  webhookEndpoints     WebhookEndpoint[]
  authoredThemes       KeyboardTheme[]      @relation("AuthoredThemes")
  likes                KeyboardLike[]
  followers            UserFollow[]         @relation("UserFollowers")
  following            UserFollow[]         @relation("UserFollowing")

  @@index([roleId])
  @@index([deletedAt])
  @@index([isCreator])
  @@index([creatorStatus])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  resource    String
  action      String
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserSocial {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_socials")
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  deviceHash  String   @map("device_hash")
  deviceName  String?  @map("device_name")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  lastLoginAt DateTime @default(now()) @map("last_login_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@map("user_devices")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  priority  String    @default("NORMAL")
  title     String
  content   String
  actionUrl String?   @map("action_url")
  metadata  Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model EmailNotification {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  toEmail      String    @map("to_email")
  subject      String
  templateKey  String    @map("template_key")
  templateData Json      @map("template_data")
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User?     @relation(fields: [userId], references: [id])

  @@index([status, attempts, createdAt])
  @@index([userId])
  @@map("email_notifications")
}

model NotificationTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  channels    Json
  subject     String?
  title       String?
  content     String
  variables   Json
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, createdAt])
  @@index([isSystem, createdAt])
  @@map("notification_templates")
}

model MaintenanceConfig {
  id                String    @id @default(uuid()) @db.Uuid
  key               String    @unique @default("DEFAULT")
  enabled           Boolean   @default(false)
  status            String    @default("ONLINE")
  title             String    @default("Hệ thống đang bảo trì")
  message           String    @default("Hệ thống đang được bảo trì để nâng cấp dịch vụ. Vui lòng quay lại sau.")
  startAt           DateTime? @map("start_at")
  estimatedEndAt    DateTime? @map("estimated_end_at")
  bypassPermissions Json      @default("[\"MAINTENANCE_MANAGE\", \"MAINTENANCE_BYPASS\"]") @map("bypass_permissions")
  bypassRoles       Json      @default("[\"ADMIN\"]") @map("bypass_roles")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  bypassIps         Json      @default("[]") @map("bypass_ips")

  @@map("maintenance_configs")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  keyHash     String    @unique @map("key_hash")
  prefix      String
  userId      String    @map("user_id") @db.Uuid
  permissions Json      @default("[]")
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("api_keys")
}

model WebhookEndpoint {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  url             String
  encryptedSecret String            @map("encrypted_secret")
  events          Json              @default("[\"*\"]")
  isActive        Boolean           @default(true) @map("is_active")
  description     String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deliveries      WebhookDelivery[]
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                String          @id @default(uuid()) @db.Uuid
  webhookEndpointId String          @map("webhook_endpoint_id") @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  event             String
  payload           Json
  signature         String
  status            String          @default("PENDING")
  statusCode        Int?            @map("status_code")
  responseBody      String?         @map("response_body")
  attempts          Int             @default(0)
  lastError         String?         @map("last_error")
  deliveredAt       DateTime?       @map("delivered_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@index([webhookEndpointId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  category    String   @default("GENERAL")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([isPublic])
  @@map("system_configs")
}

model KeyboardTheme {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String                  @unique
  description            String?
  coverUrl               String                  @map("cover_url")
  driveUrl               String                  @map("drive_url")
  platform               String                  @default("BOTH")
  status                 String                  @default("DRAFT")
  downloadCount          Int                     @default(0) @map("download_count")
  likeCount              Int                     @default(0) @map("like_count")
  isFeatured             Boolean                 @default(false) @map("is_featured")
  publishedAt            DateTime?               @map("published_at")
  createdBy              String?                 @map("created_by") @db.Uuid
  updatedBy              String?                 @map("updated_by") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  accessLevel            String                  @default("FREE") @map("access_level")
  requiredDiscordRoleIds String[]                @default([]) @map("required_discord_role_ids")
  downloads              Download[]
  previewImages          KeyboardImage[]
  categories             KeyboardThemeCategory[]
  colors                 KeyboardColor[]
  styles                 KeyboardStyle[]
  author                 User?                   @relation("AuthoredThemes", fields: [createdBy], references: [id])
  likes                  KeyboardLike[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([platform])
  @@index([accessLevel])
  @@index([downloadCount(sort: Desc)])
  @@index([likeCount(sort: Desc)])
  @@index([isFeatured])
  @@index([createdBy])
  @@map("keyboard_themes")
}

model KeyboardImage {
  id              String        @id @default(uuid()) @db.Uuid
  keyboardThemeId String        @map("keyboard_theme_id") @db.Uuid
  url             String
  altText         String?       @map("alt_text")
  position        Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at")
  theme           KeyboardTheme @relation(fields: [keyboardThemeId], references: [id], onDelete: Cascade)

  @@unique([keyboardThemeId, position])
  @@map("keyboard_images")
}

model Category {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String
  slug        String                  @unique
  description String?
  icon        String?
  color       String?
  orderIndex  Int                     @default(0) @map("order_index")
  isActive    Boolean                 @default(true) @map("is_active")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  themes      KeyboardThemeCategory[]

  @@index([isActive])
  @@index([orderIndex])
  @@map("categories")
}

model KeyboardThemeCategory {
  id              String        @id @default(uuid()) @db.Uuid
  keyboardThemeId String        @map("keyboard_theme_id") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  category        Category      @relation(fields: [categoryId], references: [id])
  theme           KeyboardTheme @relation(fields: [keyboardThemeId], references: [id], onDelete: Cascade)

  @@unique([keyboardThemeId, categoryId])
  @@index([categoryId])
  @@map("keyboard_theme_categories")
}

model Color {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  slug      String          @unique
  hex       String
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  themes    KeyboardColor[]

  @@map("colors")
}

model KeyboardColor {
  id              String        @id @default(uuid()) @db.Uuid
  keyboardThemeId String        @map("keyboard_theme_id") @db.Uuid
  colorId         String        @map("color_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  color           Color         @relation(fields: [colorId], references: [id], onDelete: Cascade)
  theme           KeyboardTheme @relation(fields: [keyboardThemeId], references: [id], onDelete: Cascade)

  @@unique([keyboardThemeId, colorId])
  @@index([colorId])
  @@map("keyboard_colors")
}

model Style {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  themes      KeyboardStyle[]

  @@map("styles")
}

model KeyboardStyle {
  id              String        @id @default(uuid()) @db.Uuid
  keyboardThemeId String        @map("keyboard_theme_id") @db.Uuid
  styleId         String        @map("style_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  style           Style         @relation(fields: [styleId], references: [id], onDelete: Cascade)
  theme           KeyboardTheme @relation(fields: [keyboardThemeId], references: [id], onDelete: Cascade)

  @@unique([keyboardThemeId, styleId])
  @@index([styleId])
  @@map("keyboard_styles")
}

model Download {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  keyboardThemeId String        @map("keyboard_theme_id") @db.Uuid
  ipAddress       String?       @map("ip_address")
  userAgent       String?       @map("user_agent")
  createdAt       DateTime      @default(now()) @map("created_at")
  theme           KeyboardTheme @relation(fields: [keyboardThemeId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([keyboardThemeId, createdAt(sort: Desc)])
  @@index([userId, keyboardThemeId])
  @@map("downloads")
}

model KeyboardLike {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  keyboardThemeId String        @map("keyboard_theme_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme           KeyboardTheme @relation(fields: [keyboardThemeId], references: [id], onDelete: Cascade)

  @@unique([userId, keyboardThemeId])
  @@index([keyboardThemeId])
  @@map("keyboard_likes")
}

model UserFollow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}

// ===== DISCORD IMPORT SYSTEM =====

model DiscordThread {
  id                     String      @id @default(uuid()) @db.Uuid
  discordThreadId        String      @unique @map("discord_thread_id")
  discordChannelId       String?     @map("discord_channel_id")
  discordReferenceNumber Int?        @map("discord_reference_number")
  originalName           String      @map("original_name")
  createdAtDiscord       DateTime?   @map("created_at_discord")
  rawData                Json        @map("raw_data")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  importJobs             ImportJob[]

  @@index([discordReferenceNumber])
  @@map("discord_threads")
}

model ImportJob {
  id              String         @id @default(uuid()) @db.Uuid
  discordThreadId String         @map("discord_thread_id") @db.Uuid
  status          String         @default("DISCOVERED")
  phase           String         @default("COLLECT")
  retryCount      Int            @default(0) @map("retry_count")
  lastError       String?        @map("last_error")
  processedAt     DateTime?      @map("processed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  thread          DiscordThread  @relation(fields: [discordThreadId], references: [id])
  draft           KeyboardDraft?

  @@index([status])
  @@index([discordThreadId])
  @@index([status, createdAt(sort: Desc)])
  @@map("import_jobs")
}

model KeyboardDraft {
  id                    String    @id @default(uuid()) @db.Uuid
  importJobId           String    @unique @map("import_job_id") @db.Uuid

  // AI-generated fields
  englishName           String?   @map("english_name")
  description           String?
  suggestedCategoryIds  String[]  @default([]) @map("suggested_category_ids")
  suggestedColorIds     String[]  @default([]) @map("suggested_color_ids")
  suggestedStyleIds     String[]  @default([]) @map("suggested_style_ids")
  suggestedTags         Json?     @map("suggested_tags")

  // AI confidence per field (0.0 - 1.0)
  confidenceName        Float?    @map("confidence_name")
  confidenceCategory    Float?    @map("confidence_category")
  confidenceColor       Float?    @map("confidence_color")
  confidenceStyle       Float?    @map("confidence_style")
  confidenceDescription Float?    @map("confidence_description")

  // Deterministic parsed fields
  platform              String?
  downloadSource        String?   @map("download_source")
  downloadUrl           String?   @map("download_url")
  downloadDiscordMsgId  String?   @map("download_discord_msg_id")
  downloadFileName      String?   @map("download_file_name")

  // Images stored in Cloudflare R2 (NOT Discord CDN)
  coverUrl              String?   @map("cover_url")
  previewUrls           String[]  @default([]) @map("preview_urls")

  // Duplicate detection
  isDuplicateCandidate  Boolean   @default(false) @map("is_duplicate_candidate")
  duplicateOfId         String?   @map("duplicate_of_id") @db.Uuid
  duplicateReason       String?   @map("duplicate_reason")

  // Validation flags (JSON array of string flag codes)
  flags                 Json?
  validationStatus      String    @default("PENDING") @map("validation_status")

  // Admin review
  adminNotes            String?   @map("admin_notes")
  reviewedBy            String?   @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime? @map("reviewed_at")

  // Linked keyboard after approval
  keyboardThemeId       String?   @map("keyboard_theme_id") @db.Uuid

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  importJob             ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([validationStatus])
  @@index([isDuplicateCandidate])
  @@index([keyboardThemeId])
  @@index([createdAt(sort: Desc)])
  @@map("keyboard_drafts")
}
